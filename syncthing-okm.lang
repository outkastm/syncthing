auth = "SyncThing"
descript = "Syncthing es un programa de sincronización continua de archivos. Sincroniza archivos entre dos o más ordenadores en tiempo real, protegidos de forma segura contra miradas indiscretas. Tus datos son solo tuyos y mereces elegir dónde se almacenan, si se comparten con algún tercero y cómo se transmiten por Internet."
release_note = "Incluye syncthing v2.1.7 empaquetado desde el código fuente"
important    = "Se ejecuta como usuario de aplicación: syncthing"

[fr-fr]
